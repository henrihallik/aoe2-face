<ELEVATION_GENERATION>

/* Required because the authored cheek and nose lands use base_elevation. */


<TERRAIN_GENERATION>

/* Varied depths make the naval ring legible without changing its topology. */
create_terrain SEA_DEEP {
    base_terrain SEA_WATER
    land_percent 52
    number_of_clumps 18
    clumping_factor 8
    spacing_to_other_terrain_types 2
    terrain_mask 1
}


<CONNECTION_GENERATION>

/* Every face band overlaps its neighbors; no generated repair road is needed. */


<OBJECTS_GENERATION>

/* Mandatory 9-villager quick start. */
create_object TOWN_CENTER {
    set_place_for_every_player
    min_distance_to_players 0
    max_distance_to_players 0
    force_placement
    actor_area TC_AREA
    actor_area_radius 7
}

create_object START_TREE {
    number_of_objects 1
    set_gaia_object_only
    set_place_for_every_player
    min_distance_to_players 5
