/* Compatibility: Age of Empires II: Definitive Edition */
/*
    Mirrorwake v0.3.4
    The Garrison 2026 map competition prototype.

    Designed for:
      - 1v1 Random Map
      - Tiny map, forced to 120 x 120 tiles for portrait fidelity
      - Standard resources
      - Mandatory 9-villager tournament quick start

    Layout and identity:
      - The complete playable island is an original smiling terrain portrait.
      - Player starts are mirrored at the ears.
      - Pine hair and dead-forest beard are ordinary harvestable woodlines.
      - Raised cheeks, bright eyes, a highlighted nose, visible teeth, and an
        exaggerated upturned mouth keep the expression readable at full zoom.
      - Five relics mark the eyes, cheeks, and nose.
      - Dockable water, carved ear coves, and fixed fish schools support
        reliable naval counterplay.

    Competitive integrity:
      - Every strategic feature is horizontally mirrored.
      - Player colors swap sides independently of the fixed portrait.
      - Mine clearings use terrain reserved from food and trees.
      - Fixed mirrored slots guarantee food, fish, gold, and stone.
      - Protected ear plateaus retain building room behind a fixed 180-tile
        front forest and two additional 64-tile home woodlines.
      - Assigned ear lands remain ID-free so DE repeats every player object.
      - No unit or building attributes are changed.
      - No triggers, XS, custom includes, scripted income, capturable
        buildings, guardians, or object-attribute changes are used.
*/

/* Reliable built-in Definitive Edition terrain IDs. */
#const FACE_GROUND 14
#const CHEEK_GROUND 41
#const NOSE_GROUND 42
#const SEA_WATER 1
#const HAIR_FOREST 19
#const BEARD_FOREST 106
#const BROW_GROUND 40
#const EYE_WHITE 32
#const TEETH_WHITE 74
#const MOUTH_GROUND 40

/* Object aliases. */
#const START_HERDABLE 594
#const START_LUREABLE 48
#const START_HUNTABLE 65
#const START_TREE 349
#const HARBOR_FISH 457
#const DECORATIVE_ROCK 623

/* Stable objective land identifiers. Player lands intentionally have no
   land_id because DE disables set_place_for_every_player when they carry one. */
#const LEFT_EYE_ID 201
#const RIGHT_EYE_ID 202
#const LEFT_CHEEK_ID 203
#const RIGHT_CHEEK_ID 204
#const NOSE_TIP_ID 205

/* Smile identifiers are validated as a geometric contract. */
#const LEFT_SMILE_CORNER_ID 301
#const SMILE_MOUTH_ID 302
#const RIGHT_SMILE_CORNER_ID 303
#const TEETH_ID 304
#const LEFT_LOWER_SMILE_ID 305
#const CENTER_LOWER_SMILE_ID 306
#const RIGHT_LOWER_SMILE_ID 307

/* Fixed mirrored resource clearings. */
#const LEFT_HOME_GOLD_ID 401
#const RIGHT_HOME_GOLD_ID 402
#const LEFT_HOME_STONE_ID 411
#const RIGHT_HOME_STONE_ID 412
#const LEFT_SECONDARY_GOLD_ID 421
#const RIGHT_SECONDARY_GOLD_ID 422
#const LEFT_SECONDARY_STONE_ID 431
#const RIGHT_SECONDARY_STONE_ID 432
#const LEFT_FORWARD_GOLD_ID 441
#const RIGHT_FORWARD_GOLD_ID 442

/* Fixed mirrored opening-food slots. */
#const LEFT_NEAR_SHEEP_ID 501
#const RIGHT_NEAR_SHEEP_ID 502
#const LEFT_FAR_SHEEP_ID 503
#const RIGHT_FAR_SHEEP_ID 504
#const LEFT_BERRIES_ID 511
#const RIGHT_BERRIES_ID 512
#const LEFT_NEAR_BOAR_ID 521
#const RIGHT_NEAR_BOAR_ID 522
#const LEFT_FAR_BOAR_ID 523
#const RIGHT_FAR_BOAR_ID 524
#const LEFT_DEER_ID 531
#const RIGHT_DEER_ID 532

/* Fixed home woodlines. */
#const LEFT_NORTH_WOOD_ID 533
#const RIGHT_NORTH_WOOD_ID 534
#const LEFT_SOUTH_WOOD_ID 535
#const RIGHT_SOUTH_WOOD_ID 536
#const LEFT_FRONT_WOOD_ID 537
#const RIGHT_FRONT_WOOD_ID 538

/* Ten fixed fish slots per side. */
#const LEFT_COVE_FISH_ID 541
#const RIGHT_COVE_FISH_ID 542
#const LEFT_UPPER_SHORE_FISH_ID 551
#const RIGHT_UPPER_SHORE_FISH_ID 552
#const LEFT_UPPER_DEEP_FISH_ID 553
#const RIGHT_UPPER_DEEP_FISH_ID 554
#const LEFT_LOWER_DEEP_FISH_ID 555
#const RIGHT_LOWER_DEEP_FISH_ID 556
#const LEFT_BOTTOM_DEEP_FISH_ID 557
#const RIGHT_BOTTOM_DEEP_FISH_ID 558
#const LEFT_LOWER_SHORE_FISH_ID 559
#const RIGHT_LOWER_SHORE_FISH_ID 560
#const LEFT_TOP_DEEP_FISH_ID 561
#const RIGHT_TOP_DEEP_FISH_ID 562
#const LEFT_UPPER_OUTER_DEEP_FISH_ID 563
#const RIGHT_UPPER_OUTER_DEEP_FISH_ID 564
#const LEFT_LOWER_OUTER_DEEP_FISH_ID 565
#const RIGHT_LOWER_OUTER_DEEP_FISH_ID 566
#const LEFT_BOTTOM_EDGE_DEEP_FISH_ID 567
#const RIGHT_BOTTOM_EDGE_DEEP_FISH_ID 568
#const LEFT_NEAR_SHORE_DEEP_FISH_ID 569
#const RIGHT_NEAR_SHORE_DEEP_FISH_ID 570
#const LEFT_NEAR_OFFSHORE_DEEP_FISH_ID 571
#const RIGHT_NEAR_OFFSHORE_DEEP_FISH_ID 572

/* Land zones. */
#const FACE_ZONE 10
#const LEFT_HOME_ZONE 11
#const RIGHT_HOME_ZONE 12
#const FEATURE_ZONE 20
#const RESOURCE_ZONE 30
#const HOME_RESOURCE_ZONE 31
#const WATER_RESOURCE_ZONE 32

/* Per-player actor areas. */
#const TC_AREA 1000
#const VILLAGER_AREA 1010

/* Player color never determines the side of the portrait. */
start_random
    percent_chance 50 #define PLAYER_ONE_LEFT
    percent_chance 50 #define PLAYER_TWO_LEFT
end_random


<PLAYER_SETUP>

direct_placement
behavior_version 2
override_map_size 120
ai_info_map_type RIVERS 0 0 0

/* Established Garrison-style adjustment for the 9-villager quick start. */
effect_amount MOD_RESOURCE AMOUNT_STARTING_WOOD ATTR_ADD -30
effect_amount MOD_RESOURCE AMOUNT_STARTING_FOOD ATTR_ADD -100


